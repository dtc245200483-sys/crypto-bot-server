        <!-- Col 4: Tuyên Bố Rủi Ro & Pháp Lý -->
        <div class="support-col support-col-disclaimer">
          <h4 class="support-col-title">Cảnh Báo Rủi Ro</h4>
          <p class="support-disclaimer-text">
            Giao dịch phái sinh Crypto có rủi ro biến động vốn cao. Tín hiệu trên bảng kèo được tổng hợp thuật toán định lượng tự động nhằm mục đích hỗ trợ phân tích và tham khảo, không cấu thành lời khuyên đầu tư tài chính. Quý trader luôn chủ động quản trị vốn và tuân thủ Stop Loss nghiêm ngặt.
          </p>
          <div class="support-copy-row">
            <span>© 2026 BOT CRYPTO PRO. Tất cả quyền được bảo lưu.</span>
          </div>
        </div>
      </div>
    </footer>
  </div>

  <!-- ========================================================================= -->
  <!-- AUTH MODAL (ĐĂNG NHẬP / ĐĂNG KÝ TÀI KHOẢN TRADER)                        -->
  <!-- ========================================================================= -->
  <div class="modal-overlay hidden" id="authModalOverlay" aria-modal="true" role="dialog">
    <div class="auth-modal" id="authModal">
      <!-- Modal Header -->
      <div class="auth-modal-header">
        <div class="auth-brand-logo">
          <img src="assets/moon-logo.svg" alt="Moon Logo" class="auth-moon-icon">
          <div class="auth-brand-info">
            <span class="auth-brand-title">BOT CRYPTO <span class="badge-pro">PRO</span></span>
          </div>
        </div>
        <button class="modal-close-btn" id="closeAuthBtn" aria-label="Đóng cửa sổ">✕</button>
      </div>

      <!-- Auth Tab Switcher -->
      <div class="auth-tabs" role="tablist">
        <button class="auth-tab active" id="tabLoginBtn" type="button" role="tab" aria-selected="true" data-tab="login">
          <span>Đăng Nhập</span>
        </button>
        <button class="auth-tab" id="tabRegisterBtn" type="button" role="tab" aria-selected="false" data-tab="register">
          <span>Đăng Ký</span>
        </button>
      </div>

      <!-- Notification Toast inside modal -->
      <div class="auth-feedback hidden" id="authFeedback"></div>

      <!-- LOGIN FORM -->
      <form id="loginForm" class="auth-form" autocomplete="on">
        <div class="form-group">
          <label class="form-label" for="loginEmail">Email hoặc Tên đăng nhập</label>
          <div class="auth-input-wrap">
            <span class="input-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </span>
            <input type="text" id="loginEmail" class="auth-input" placeholder="trader@botcrypto.pro" required autocomplete="username">
          </div>
        </div>

        <div class="form-group">
          <div class="label-row-split">
            <label class="form-label" for="loginPassword">Mật khẩu</label>
            <a href="javascript:void(0)" class="forgot-pwd-link" id="forgotPwdLink">Quên mật khẩu?</a>
          </div>
          <div class="auth-input-wrap">
            <span class="input-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </span>
            <input type="password" id="loginPassword" class="auth-input" placeholder="••••••••" required autocomplete="current-password">
            <button type="button" class="pwd-toggle-btn" data-target="loginPassword" title="Ẩn/Hiện mật khẩu">👁️</button>
          </div>
        </div>

        <div class="form-remember-row">
          <label class="remember-label">
            <input type="checkbox" id="loginRemember" checked>
            <span>Ghi nhớ đăng nhập</span>
          </label>
        </div>

        <button type="submit" class="btn-auth-submit" id="loginSubmitBtn">
          <span>Đăng Nhập Ngay</span>
        </button>

        <div class="auth-divider">
          <span>HOẶC</span>
        </div>

        <button type="button" class="btn-google-login" id="googleLoginBtn">
          <svg class="google-icon" width="18" height="18" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
            <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 10.04 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
          </svg>
          <span>Đăng nhập bằng Gmail (Google)</span>
        </button>
      </form>

      <!-- REGISTER FORM -->
      <form id="registerForm" class="auth-form hidden" autocomplete="on">
        <div class="form-group">
          <label class="form-label" for="regUsername">Biệt danh Trader (Username)</label>
          <div class="auth-input-wrap">
            <span class="input-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </span>
            <input type="text" id="regUsername" class="auth-input" placeholder="Ví dụ: SatoshiTrader" required minlength="3" autocomplete="username">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="regEmail">Địa chỉ Email</label>
          <div class="auth-input-wrap">
            <span class="input-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </span>
            <input type="email" id="regEmail" class="auth-input" placeholder="trader@domain.com" required autocomplete="email">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="regPassword">Mật khẩu</label>
          <div class="auth-input-wrap">
            <span class="input-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </span>
            <input type="password" id="regPassword" class="auth-input" placeholder="Tối thiểu 6 ký tự" required minlength="6" autocomplete="new-password">
            <button type="button" class="pwd-toggle-btn" data-target="regPassword" title="Ẩn/Hiện mật khẩu">👁️</button>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="regConfirmPassword">Xác nhận Mật khẩu</label>
          <div class="auth-input-wrap">
            <span class="input-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </span>
            <input type="password" id="regConfirmPassword" class="auth-input" placeholder="Nhập lại mật khẩu" required minlength="6" autocomplete="new-password">
            <button type="button" class="pwd-toggle-btn" data-target="regConfirmPassword" title="Ẩn/Hiện mật khẩu">👁️</button>
          </div>
        </div>

        <div class="form-terms-row">
          <label class="terms-label">
            <input type="checkbox" id="regTerms" required checked>
            <span>Tôi đồng ý với Điều khoản dịch vụ và Cảnh báo rủi ro giao dịch</span>
          </label>
        </div>

        <button type="submit" class="btn-auth-submit" id="regSubmitBtn">
          <span>Tạo Tài Khoản Trader</span>
        </button>
      </form>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- SETTINGS MODAL (CÀI ĐẶT BỘ LỌC VÀ NHẬN TÍN HIỆU 15P, 30P, 1H, 4H)       -->
  <!-- ========================================================================= -->
  <div class="modal-overlay hidden" id="settingsModalOverlay" aria-modal="true" role="dialog">
    <div class="settings-modal" id="settingsModal">
      <!-- Modal Header -->
      <div class="modal-header">
        <div class="modal-title-group">
          <div class="modal-icon-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </div>
          <div>
            <h2 class="modal-title">Cài Đặt Bộ Lọc &amp; Nhận Tín Hiệu</h2>
            <p class="modal-desc">Quản lý nhận tín hiệu theo từng khung giờ riêng biệt và tùy chỉnh các ngưỡng lọc.</p>
          </div>
        </div>
        <button class="modal-close-btn" id="closeSettingsBtn" aria-label="Đóng cài đặt">✕</button>
      </div>

      <!-- Modal Body -->
      <div class="modal-body">
        <!-- SECTION 1: TIMEFRAMES SWITCHES -->
        <div class="settings-section">
          <div class="section-title-wrap">
            <span class="section-badge">1</span>
            <div>
              <h3 class="section-heading">Cấu Hình Khung Vào Lệnh (30p • 1h • 4h)</h3>
              <p class="section-sub">Khung 15p chỉ dùng để xem và xác nhận phụ. Vào lệnh chỉ kích hoạt khi khung 30p, 1h hoặc 4h xác nhận.</p>
            </div>
          </div>

          <div class="tf-toggles-grid">
            <!-- 15m Info Card (Chỉ xem và xác nhận) -->
            <div class="tf-toggle-card card-15m" id="cardTf15m" style="border: 1px dashed rgba(56, 189, 248, 0.4); background: rgba(56, 189, 248, 0.04);">
              <div class="tf-toggle-info">
                <span class="tf-badge-pill tf-15m-badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8;">15p (15m)</span>
                <div>
                  <div class="tf-card-title">Khung 15 Phút <span style="font-size: 11px; color: #38bdf8; font-weight: normal; margin-left: 4px;">(Chỉ Xem &amp; Xác Nhận)</span></div>
                  <div class="tf-card-desc">Dùng quan sát động lượng &amp; xác nhận phụ, KHÔNG vào lệnh</div>
                </div>
              </div>
              <div class="tf-toggle-action">
                <span class="tf-status-text" id="statusText15m" style="color: #38bdf8;">Chỉ xác nhận</span>
                <label class="switch" style="opacity: 0.6; pointer-events: none;" title="15p chỉ dùng xem/xác nhận, không dùng làm khung vào lệnh">
                  <input type="checkbox" id="toggleTf15m" checked disabled>
                  <span class="slider"></span>
                </label>
              </div>
            </div>

            <!-- 30m Toggle Card -->
            <div class="tf-toggle-card card-30m" id="cardTf30m">
              <div class="tf-toggle-info">
                <span class="tf-badge-pill tf-30m-badge">30p (30m)</span>
                <div>
                  <div class="tf-card-title">Khung 30 Phút</div>
                  <div class="tf-card-desc">Intraday ngắn hạn, xác nhận động lượng</div>
                </div>
              </div>
              <div class="tf-toggle-action">
                <span class="tf-status-text" id="statusText30m">Đang nhận</span>
                <label class="switch">
                  <input type="checkbox" id="toggleTf30m" checked>
                  <span class="slider"></span>
                </label>
              </div>
            </div>

            <!-- 1h Toggle Card -->
            <div class="tf-toggle-card card-1h" id="cardTf1h">
              <div class="tf-toggle-info">
                <span class="tf-badge-pill tf-1h-badge">1h (60m)</span>
                <div>
                  <div class="tf-card-title">Khung 1 Giờ</div>
                  <div class="tf-card-desc">Khung cơ sở tiêu chuẩn, lọc nhiễu tốt</div>
                </div>
              </div>
              <div class="tf-toggle-action">
                <span class="tf-status-text" id="statusText1h">Đang nhận</span>
                <label class="switch">
                  <input type="checkbox" id="toggleTf1h" checked>
                  <span class="slider"></span>
                </label>
              </div>
            </div>

            <!-- 4h Toggle Card -->
            <div class="tf-toggle-card card-4h" id="cardTf4h">
              <div class="tf-toggle-info">
                <span class="tf-badge-pill tf-4h-badge">4h (240m)</span>
                <div>
                  <div class="tf-card-title">Khung 4 Giờ</div>
                  <div class="tf-card-desc">Xu hướng lớn / Swing, độ tin cậy cao nhất</div>
                </div>
              </div>
              <div class="tf-toggle-action">
                <span class="tf-status-text" id="statusText4h">Đang nhận</span>
                <label class="switch">
                  <input type="checkbox" id="toggleTf4h" checked>
                  <span class="slider"></span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- SECTION 2: TECHNICAL THRESHOLDS -->
        <div class="settings-section">
          <div class="section-title-wrap">
            <span class="section-badge">2</span>
            <div>
              <h3 class="section-heading">Ngưỡng Lọc Kỹ Thuật Tập Trung</h3>
              <p class="section-sub">Chỉ lưu các kèo thỏa mãn đồng thời cả 3 tiêu chí dưới đây.</p>
            </div>
          </div>

          <div class="threshold-inputs-grid">
            <div class="input-card">
              <label for="cfgMinWinRate" class="input-label">
                <span>Tối thiểu Win Rate (%)</span>
                <span class="input-hint">Mặc định: 42.0%</span>
              </label>
              <div class="input-number-wrap">
                <input type="number" id="cfgMinWinRate" step="0.5" min="0" max="100" value="42.0">
                <span class="input-unit">%</span>
              </div>
            </div>

            <div class="input-card">
              <label for="cfgMinProfitFactor" class="input-label">
                <span>Tối thiểu Profit Factor</span>
                <span class="input-hint">Mặc định: 0.80</span>
              </label>
              <div class="input-number-wrap">
                <input type="number" id="cfgMinProfitFactor" step="0.05" min="0" max="10" value="0.80">
                <span class="input-unit">PF</span>
              </div>
            </div>

            <div class="input-card">
              <label for="cfgMinTotalPnL" class="input-label">
                <span>Tối thiểu Total PnL ($)</span>
                <span class="input-hint">Mặc định: $0</span>
              </label>
              <div class="input-number-wrap">
                <input type="number" id="cfgMinTotalPnL" step="10" min="-1000" max="100000" value="0.0">
                <span class="input-unit">$</span>
              </div>
            </div>
          </div>
        </div>

        <!-- SECTION 3: SYSTEM & NOTIFICATIONS -->
        <div class="settings-section">
          <div class="section-title-wrap">
            <span class="section-badge">3</span>
            <div>
              <h3 class="section-heading">Tùy Chọn Thông Báo &amp; Làm Mới</h3>
              <p class="section-sub">Thiết lập âm thanh cảnh báo và tần suất cập nhật dữ liệu tự động.</p>
            </div>
          </div>

          <div class="options-row">
            <div class="option-item">
              <div class="option-info">
                <div class="option-title">Âm thanh chuông báo (Chime)</div>
                <div class="option-desc">Phát âm thanh nhẹ khi phát hiện có kèo mới đạt chuẩn</div>
              </div>
              <div class="option-controls">
                <button type="button" class="btn-test-sound" id="btnTestSound" title="Thử nghe âm thanh">
                  🔊 Thử âm
                </button>
                <label class="switch">
                  <input type="checkbox" id="cfgSoundAlert" checked>
                  <span class="slider"></span>
                </label>
              </div>
            </div>

            <div class="option-item">
              <div class="option-info">
                <div class="option-title">Thời gian tự động làm mới</div>
                <div class="option-desc">Chu kỳ truy vấn dữ liệu setup mới từ máy chủ</div>
              </div>
              <div class="option-controls">
                <select id="cfgRefreshInterval" class="custom-select">
                  <option value="10">10 giây (Nhanh)</option>
                  <option value="30" selected>30 giây (Chuẩn)</option>
                  <option value="60">60 giây (Tiết kiệm)</option>
                  <option value="0">Tắt tự làm mới</option>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="modal-footer">
        <div class="footer-left">
          <button type="button" class="btn-ghost" id="resetDefaultSettingsBtn">
            Khôi phục mặc định
          </button>
        </div>
        <div class="footer-right">
          <button type="button" class="btn-secondary" id="cancelSettingsBtn">
            Hủy bỏ
          </button>
          <button type="button" class="btn-primary" id="saveSettingsBtn">
            <span class="btn-spinner hidden" id="saveSpinner"></span>
            <span>Lưu Cấu Hình</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification Container -->
  <div class="toast-container" id="toastContainer"></div>

  <!-- GSAP 3.12 (GreenSock Animation Platform) - Tham khảo repo: https://github.com/greensock/GSAP -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

  <!-- Fuse.js 7.0 (Fuzzy Search Engine) - Tham khảo repo: https://github.com/krisk/Fuse -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/fuse.js/7.0.0/fuse.min.js"></script>

  <!-- TradingView Lightweight Charts - Tham khảo repo: https://github.com/tradingview/lightweight-charts -->
  <script src="vendor/lightweight-charts.standalone.production.js"></script>
  <script>
    if (!window.LightweightCharts) {
      document.write('<script src="https://unpkg.com/lightweight-charts/dist/lightweight-charts.standalone.production.js"><\/script>');
    }
  </script>
  <!-- Interactive Moon Spotlight & Video Loop Synchronizer -->
  <script src="moon-scratch.js"></script>
  <script src="app.js?v=9"></script>
</body>
</html>
