<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BOT CRYPTO PRO — Giao Dịch Phái Sinh Tự Động &amp; Bảng Kèo TradingView OKX</title>
  <meta name="description" content="BOT CRYPTO PRO — Hệ thống điều phối &amp; Bảng tổng hợp tín hiệu phái sinh đạt chuẩn đa khung thời gian 15p, 30p, 1h, 4h từ TradingView sang OKX.">
  <link rel="icon" type="image/svg+xml" href="assets/moon-logo.svg">
  <link rel="stylesheet" href="style.css?v=10">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Khởi tạo sớm theme & color variant để chống giật màn hình (FOUC) -->
  <script>
    (function() {
      try {
        var variant = localStorage.getItem('landing-color-variant');
        var savedTheme = localStorage.getItem('orchestrator_theme') || localStorage.getItem('theme');
        var theme = savedTheme || (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        if (variant === 'white') theme = 'light';
        else if (variant === 'gray' || variant === 'dark') theme = 'dark';
        document.documentElement.setAttribute('data-theme', theme);
        if (variant === 'gray') {
          document.documentElement.classList.add('variant-gray');
      } catch (e) {}
    })();
  </script>
  <!-- Google Identity Services SDK (Chính hãng từ Google) -->
  <script src="https://accounts.google.com/gsi/client" async defer></script>
</head>
<body>
  <!-- Ambient background glow elements -->
  <div class="ambient-glow glow-top-left"></div>
  <div class="ambient-glow glow-top-right"></div>
  <div class="ambient-glow glow-bottom-center"></div>

  <!-- Top Navigation Header -->
  <header class="top-nav" id="topNav">
    <div class="nav-brand">
      <a href="#hero" class="nav-brand-link" aria-label="BOT CRYPTO PRO - Trang chủ">
        <div class="brand-moon-icon" aria-hidden="true">
          <img src="assets/moon-logo.svg" alt="Moon Logo" class="brand-moon-img">
        </div>
        <div class="brand-text">
          <div class="brand-title-wrap">
            <span class="brand-title">BOT CRYPTO <span class="badge-pro">PRO</span></span>
          </div>
        </div>
      </a>
    </div>

    <!-- Center Navigation Links -->
    <nav class="nav-menu" aria-label="Điều hướng chính">
      <a href="#hero" class="nav-link active">Trang Chủ</a>
      <a href="#dashboardSection" class="nav-link">Bảng Kèo</a>
      <a href="#metricsSection" class="nav-link">Thống Kê</a>
      <a href="#introSection" class="nav-link">Giới Thiệu</a>
    </nav>

    <!-- Action Toolbar Right -->
    <div class="nav-meta">
      <div class="countdown-badge" id="countdownBadge" title="Tự động cập nhật dữ liệu">
        <span class="countdown-spinner"></span>
        <span>Làm mới sau: <b id="countdownTimer">30</b>s</span>
      </div>

      <button id="soundToggleBtn" class="icon-action-btn" title="Bật/Tắt chuông báo khi có kèo mới" aria-label="Bật tắt âm thanh">
        <svg id="soundOnIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        </svg>
        <svg id="soundOffIcon" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <line x1="23" y1="9" x2="17" y2="15"></line>
          <line x1="17" y1="9" x2="23" y2="15"></line>
        </svg>
      </button>

      <!-- Color Variant Switcher: White / Gray / Dark Cosmic -->
      <div class="color-switcher" role="group" aria-label="Chọn giao diện màu">
        <button class="color-dot color-dot-white" id="colorDotWhite" data-variant="white" title="Giao diện Sáng (White)" aria-label="Giao diện Sáng"></button>
        <button class="color-dot color-dot-gray" id="colorDotGray" data-variant="gray" title="Giao diện Xám Hiện Đại (Gray)" aria-label="Giao diện Xám"></button>
        <button class="color-dot color-dot-dark active" id="colorDotDark" data-variant="dark" title="Giao diện Vũ Trụ Tối (Dark Cosmic)" aria-label="Giao diện Vũ Trụ Tối"></button>
      </div>

      <!-- Theme Toggle (Dark / Light Mode) -->
      <button id="themeToggleBtn" class="icon-action-btn theme-toggle-btn" title="Chuyển đổi giao diện Sáng / Tối (Dark / Light mode)" aria-label="Đổi giao diện Sáng / Tối">
        <svg id="themeSunIcon" class="theme-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg id="themeMoonIcon" class="theme-icon hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <button id="openSettingsBtn" class="btn-settings hidden" title="Mở cài đặt bộ lọc và nhận tín hiệu">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        <span>Cài đặt</span>
      </button>

      <!-- Authentication Controls (Đăng Nhập / Đăng Ký) -->
      <div class="auth-header-wrap" id="authHeaderWrap">
        <button id="authOpenModalBtn" class="btn-auth-header" title="Đăng Nhập / Đăng Ký Tài Khoản">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span id="authBtnLabel">Đăng Nhập</span>
        </button>
        <div id="userProfileBadge" class="user-profile-badge hidden" title="Tài khoản cá nhân">
          <div class="user-avatar-mini" id="userAvatarMini">TP</div>
          <div class="user-info-text">
            <span class="user-display-name" id="userDisplayName">Trader VIP</span>
            <span class="user-vip-tag">PRO</span>
          </div>
          <button id="authLogoutBtn" class="btn-logout-mini" title="Đăng Xuất">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- ============================================================
       HERO SECTION — BOT CRYPTO GALAXY & INTERACTIVE MOON
       ============================================================ -->
  <section class="hero" id="hero" aria-label="Hero">
    <!-- Hero Background Video: 1440p ultra-sharp galaxy loop -->
    <div class="hero-bg-wrapper" id="heroBgWrapper" aria-hidden="true">
      <video class="hero-bg-video" id="heroBgVideo" autoplay muted loop playsinline preload="auto">
        <source src="assets/bg-video.mp4" type="video/mp4">
      </video>
      <div class="hero-bg-overlay"></div>
    </div>

    <!-- Left Content -->
    <div class="hero-content">
      <p class="hero-eyebrow">Tương lai của giao dịch thông minh</p>
      <h1 class="hero-title">
        <span>BOT</span>
        <span>CRYPTO</span>
      </h1>
      <p class="hero-desc">
        Hệ thống phân tích &amp; điều phối phái sinh OKX thế hệ mới.
        Đồng thuận đa khung thời gian 15p → 4h, lọc tín hiệu theo Win Rate,
        Profit Factor và Total PnL — chính xác, an toàn, hiệu quả.
      </p>

      <div class="hero-btn-row">
        <button class="btn-explore" id="exploreBtn" type="button" aria-label="Xem Bảng Kèo Trực Tiếp">
          <span class="btn-explore-arrow" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"/>
              <polyline points="19 12 12 19 5 12"/>
            </svg>
          </span>
          <span class="btn-explore-label">Xem Bảng Kèo Trực Tiếp</span>
        </button>
      </div>
    </div>

    <!-- Interactive Moon with Half-Moon Flower Reveal -->
    <div class="moon-wrap" id="moonWrap" role="region" aria-label="Mặt trăng tương tác">
      <!-- Lớp hoa nằm DƯỚI (z-index thấp hơn) -->
      <img class="flower-layer" id="flowerLayer" src="assets/beautiful-flower.jpg" alt="Ảnh hoa nghệ thuật" draggable="false" />

      <!-- Lớp mặt trăng nằm TRÊN, mix-blend-mode: screen, mask-image động theo chuột -->
      <video class="moon-layer" id="moonLayer" autoplay muted loop playsinline preload="auto">
        <source src="assets/moon-video.mp4" type="video/mp4">
      </video>

      <!-- Watermark covers: 2 khối div đen che logo AI góc trên trái và Dreamina AI góc dưới phải -->
      <div class="wm-cover wm-cover-tl" id="wmCoverTl" aria-hidden="true"></div>
      <div class="wm-cover wm-cover-br" id="wmCoverBr" aria-hidden="true"></div>
    </div>

    <!-- Orbit Decoration — bottom-left corner -->
    <div class="orbit-decoration" id="orbitDecoration" aria-hidden="true">
      <svg class="orbit-svg" viewBox="0 0 96 56"
           xmlns="http://www.w3.org/2000/svg" overflow="visible">
        <defs>
          <linearGradient id="orbitRingGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%"   stop-color="rgba(255,255,255,0.05)"/>
            <stop offset="20%"  stop-color="rgba(255,255,255,0.80)"/>
            <stop offset="50%"  stop-color="rgba(255,255,255,0.25)"/>
            <stop offset="80%"  stop-color="rgba(255,255,255,0.70)"/>
            <stop offset="100%" stop-color="rgba(255,255,255,0.05)"/>
          </linearGradient>
          <linearGradient id="orbitRingGrad2" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%"   stop-color="rgba(255,255,255,0.0)"/>
            <stop offset="30%"  stop-color="rgba(255,255,255,0.5)"/>
            <stop offset="70%"  stop-color="rgba(255,255,255,0.2)"/>
            <stop offset="100%" stop-color="rgba(255,255,255,0.0)"/>
          </linearGradient>
          <filter id="orbitGlow" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="1.5" result="B"/>
            <feMerge><feMergeNode in="B"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <radialGradient id="ringTubeGrad" cx="50%" cy="50%" r="50%">
            <stop offset="0%"   stop-color="rgba(255,255,255,0.9)"/>
            <stop offset="40%"  stop-color="rgba(255,255,255,0.4)"/>
            <stop offset="100%" stop-color="rgba(200,200,200,0.0)"/>
          </radialGradient>
          <filter id="ringGlow" x="-20%" y="-40%" width="140%" height="180%">
            <feGaussianBlur stdDeviation="1.8" result="B"/>
            <feMerge><feMergeNode in="B"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
        </defs>
        <ellipse cx="48" cy="52" rx="36" ry="4" fill="rgba(0,0,0,0.10)" filter="url(#ringGlow)"/>
        <ellipse cx="48" cy="28" rx="44" ry="18" fill="none" stroke="url(#orbitRingGrad)" stroke-width="4" filter="url(#ringGlow)"/>
        <ellipse cx="48" cy="28" rx="44" ry="18" fill="none" stroke="rgba(0,0,0,0.12)" stroke-width="1.5" stroke-dasharray="60 100"/>
        <ellipse cx="48" cy="28" rx="34" ry="13" fill="none" stroke="url(#orbitRingGrad2)" stroke-width="2.5"/>
        <g class="orbit-planet">
          <circle cx="92" cy="28" r="5" fill="rgba(255,255,255,0.92)" filter="url(#orbitGlow)"/>
          <circle cx="92" cy="28" r="8" fill="rgba(255,255,255,0.25)"/>
        </g>
        <ellipse cx="48" cy="28" rx="44" ry="18" fill="none" stroke="rgba(255,255,255,0.8)" stroke-width="2" stroke-dasharray="30 10 20 50" stroke-dashoffset="10"/>
      </svg>
    </div>
  </section>

  <!-- ============================================================
       MAIN DASHBOARD LAYOUT
       ============================================================ -->
  <div class="main-layout" id="dashboardSection">

    <!-- Stat Summary Cards -->
    <section class="metrics-grid" id="metricsSection" aria-label="Thống kê tổng quan">
      <!-- Total Setups Card -->
      <div class="metric-card card-total">
        <div class="metric-glass-highlight"></div>
        <div class="metric-header">
          <span class="metric-title">Tổng Kèo Đạt Chuẩn</span>
          <span class="metric-icon-badge badge-blue">🎯</span>
        </div>
        <div class="metric-main-row">
          <div class="metric-value" id="totalSetupsCount">0</div>
          <span class="metric-trend-pill" id="totalTrendPill">Tự động lọc</span>
        </div>
        <div class="metric-sub" id="totalSetupsSub">Đa khung: 15p • 30p • 1h • 4h</div>
      </div>

      <!-- Long Signals Card -->
      <div class="metric-card card-long">
        <div class="metric-glass-highlight"></div>
        <div class="metric-header">
          <span class="metric-title">Tín Hiệu LONG</span>
          <span class="metric-icon-badge badge-green">📈</span>
        </div>
        <div class="metric-main-row">
          <div class="metric-value long-text" id="longSetupsCount">0</div>
          <span class="metric-ratio-pill long-ratio" id="longRatioPill">0%</span>
        </div>
        <div class="metric-sub">Đồng thuận xu hướng Tăng</div>
      </div>

      <!-- Short Signals Card -->
      <div class="metric-card card-short">
        <div class="metric-glass-highlight"></div>
        <div class="metric-header">
          <span class="metric-title">Tín Hiệu SHORT</span>
          <span class="metric-icon-badge badge-red">📉</span>
        </div>
        <div class="metric-main-row">
          <div class="metric-value short-text" id="shortSetupsCount">0</div>
          <span class="metric-ratio-pill short-ratio" id="shortRatioPill">0%</span>
        </div>
        <div class="metric-sub">Đồng thuận xu hướng Giảm</div>
      </div>

      <!-- Win Rate Card -->
      <div class="metric-card card-winrate">
        <div class="metric-glass-highlight"></div>
        <div class="metric-header">
          <span class="metric-title">Win Rate & PF Trung Bình</span>
          <span class="metric-icon-badge badge-amber">⚡</span>
        </div>
        <div class="metric-main-row">
          <div class="metric-value amber-text" id="avgWinRate">0.0%</div>
          <span class="metric-pf-badge" id="avgPfBadge">PF: 0.00</span>
        </div>
        <div class="metric-sub" id="thresholdDisplaySub">Ngưỡng lọc: WR &gt; 42% • PF &gt; 0.8</div>
      </div>
    </section>



    <!-- Filter & Controls Toolbar -->
    <section class="toolbar-card" aria-label="Bộ lọc dữ liệu">
      <div class="toolbar-left">
        <!-- Search Input -->
        <div class="search-input-wrapper">
          <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="searchInput" placeholder="Tìm theo symbol (BTC, ETH, SOL...)" autocomplete="off">
          <kbd class="search-kbd">Ctrl K</kbd>
        </div>

        <!-- Quick Filter Tabs -->
        <div class="quick-filter-group" id="quickFilterGroup">
          <button class="filter-chip active" data-filter="all">Tất cả</button>
          <button class="filter-chip tf-15m-chip" data-filter="15m">15p</button>
          <button class="filter-chip tf-30m-chip" data-filter="30m">30p</button>
          <button class="filter-chip tf-1h-chip" data-filter="1h">1h</button>
          <button class="filter-chip tf-4h-chip" data-filter="4h">4h</button>
          <span class="filter-divider"></span>
          <button class="filter-chip long-chip" data-filter="long">📈 LONG</button>
          <button class="filter-chip short-chip" data-filter="short">📉 SHORT</button>
        </div>

        <!-- Hidden Native Selects for backward compatibility -->
        <select id="timeframeFilter" class="hidden-select" aria-label="Lọc theo khung thời gian">
          <option value="all">Tất cả khung (15p, 30p, 1h, 4h)</option>
          <option value="15m">Khung 15p</option>
          <option value="30m">Khung 30p</option>
          <option value="1h">Khung 1h</option>
          <option value="4h">Khung 4h</option>
        </select>

        <select id="signalFilter" class="hidden-select" aria-label="Lọc theo vị thế">
          <option value="all">Tất cả vị thế</option>
          <option value="long">Chỉ LONG</option>
          <option value="short">Chỉ SHORT</option>
        </select>
      </div>

      <div class="toolbar-right">
        <!-- Sort Dropdown -->
        <div class="sort-wrapper">
          <label for="sortSelect">Sắp xếp:</label>
          <select id="sortSelect" class="custom-select">
            <option value="newest">Quét mới nhất</option>
            <option value="winrate">Win Rate cao nhất</option>
            <option value="pf">Profit Factor cao nhất</option>
            <option value="pnl">Total PnL cao nhất</option>
          </select>
        </div>

        <button id="clearSetupsBtn" class="clear-btn" title="Xóa toàn bộ dữ liệu hiện tại">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          <span>Xóa dữ liệu</span>
        </button>

        <button id="refreshBtn" class="refresh-btn" title="Tải lại danh sách ngay lập tức">
          <svg class="refresh-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M23 4v6h-6"></path>
            <path d="M1 20v-6h6"></path>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
          <span>Làm mới</span>
        </button>
      </div>
    </section>

    <!-- Main Table Container -->
    <main class="table-container" aria-label="Bảng danh sách kèo">
      <div class="table-header-info">
        <div class="table-header-left-group">
          <span id="tableShowingCount">Đang hiển thị <b>0</b> setup</span>
          <div class="system-thresholds-inline" id="footerThresholds">
            <span class="threshold-label">Cấu hình hệ thống:</span>
            <span class="badge-pill" id="footWr">Win Rate &gt; <b>42%</b></span>
            <span class="badge-pill" id="footPf">Profit Factor &gt; <b>0.8</b></span>
            <span class="badge-pill" id="footPnl">Total PnL &gt; <b>$0</b></span>
            <span class="badge-pill highlight-pill" id="footActiveTfs">Đang nhận: <b>30p, 1h, 4h</b></span>
          </div>
        </div>
        <span class="live-tag"><span class="live-dot"></span>Dữ liệu thời gian thực</span>
      </div>

      <div class="table-scroll-wrapper">
        <table class="data-table pro-matrix">
          <thead>
            <tr>
              <th style="width: 36px; text-align: center;">#</th>
              <th>Symbol &amp; Coin</th>
              <th style="text-align: center; width: 125px;">Khung &amp; Vị thế</th>
              <th style="text-align: right; width: 155px;">Entry &amp; Stop Loss</th>
              <th style="text-align: center; width: 215px;">Mục Tiêu TP1 • TP2 • TP3</th>
              <th style="text-align: center; width: 210px;">Hiệu Suất (WR • PF • PnL)</th>
              <th style="text-align: center; width: 145px;">Đồng Thuận &amp; Giờ</th>
              <th style="text-align: center; width: 135px;">Thao Tác</th>
            </tr>
          </thead>
          <tbody id="setupsTableBody">
            <tr>
              <td colspan="8" class="loading-placeholder">
                <div class="loader"></div>
                <span>Đang tải danh sách kèo đẹp...</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Empty State Message -->
      <div id="emptyMessage" class="empty-state hidden">
        <div class="empty-icon">🔍</div>
        <h3>Không tìm thấy setup nào phù hợp</h3>
        <p>Thử đổi bộ lọc khung thời gian (15p, 30p, 1h, 4h) hoặc kiểm tra cài đặt nhận tín hiệu.</p>
        <button id="resetFiltersBtn" class="btn-secondary">Đặt lại bộ lọc</button>
      </div>
    </main>

