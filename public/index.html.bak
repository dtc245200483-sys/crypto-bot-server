            <span class="studio-level-chip sl">SL: <b id="studioSlVal">$0.00</b></span>
            <span class="studio-level-chip tp">TP1: <b id="studioTp1Val">$0.00</b></span>
            <span class="studio-level-chip tp">TP2: <b id="studioTp2Val">$0.00</b></span>
            <span class="studio-level-chip tp">TP3: <b id="studioTp3Val">$0.00</b></span>
          </div>
        </div>

        <div class="studio-toolbar">
          <div class="studio-mode-toggle" id="studioModeToggle">
            <button class="studio-mode-btn active" data-mode="grid" title="Xem 3 biểu đồ mini cùng lúc">Lưới 3 Khung</button>
            <button class="studio-mode-btn" data-mode="30m" title="Phóng to khung 30p">30p</button>
            <button class="studio-mode-btn" data-mode="1H" title="Phóng to khung 1h">1h</button>
            <button class="studio-mode-btn" data-mode="4H" title="Phóng to khung 4h">4h</button>
          </div>
          <button id="studioSyncBtn" class="studio-btn-action" title="Tải lại nến mới nhất từ sàn OKX">
            🔄 Cập nhật nến
          </button>
