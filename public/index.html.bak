    <!-- DOCKED CHART STUDIO (PHÒNG XEM NẾN ĐỘC LẬP - ZERO HORIZONTAL SCROLL)     -->
    <!-- ========================================================================= -->
    <section id="chartStudioPanel" class="docked-chart-studio hidden" aria-label="Phòng xem nến độc lập">
      <div class="studio-header">
